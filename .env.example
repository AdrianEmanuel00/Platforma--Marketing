# Baza de date locală (SQLite în .data/). Pornită automat local, oprită pe Vercel.
# "off" o oprește (datele rămân doar în browser), "on" o forțează.
LOCAL_DB=

# Login (magic link). Lasă gol ca aplicația să se deschidă direct, fără cont.
AUTH_ENABLED=

# Copiază în .env.local. Fără valorile Supabase, aplicația rulează în modul demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Agenții (pasul 3)
ANTHROPIC_API_KEY=
# economic (Haiku 5.5, implicit) | echilibrat (Sonnet 5.5) | maxim (Opus 5.5)
AI_TIER=economic
# pollinations (gratuit) | fal | higgsfield. Gol: fal dacă există FAL_KEY, altfel pollinations
IMAGE_PROVIDER=
FAL_KEY=

# Facebook + Instagram (aplicație de pe developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
# Opțional: Facebook Login for Business (configurație) în loc de lista de permisiuni
META_CONFIG_ID=
# Opțional: adresa publică fixă, dacă linkul de întoarcere de la Facebook trebuie să fie mereu același
APP_URL=

# Opțional: o parolă pentru toată aplicația. Recomandat după ce conectezi conturi reale.
APP_PASSWORD=

# Criptarea token-urilor rețelelor sociale (32 de octeți, base64)
TOKEN_ENCRYPTION_KEY=
